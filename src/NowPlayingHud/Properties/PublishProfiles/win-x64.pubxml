<?xml version="1.0" encoding="utf-8"?>
<!--
  Публікація тримається тут, а не в .csproj, свідомо:
  RuntimeIdentifier + SelfContained у PropertyGroup проєкту змінюють вивід
  і для звичайного `dotnet build` — кожна збірка починає копіювати весь
  рантайм, і внутрішній цикл розробки стає в рази повільнішим.

  Запуск:  dotnet publish src/NowPlayingHud -p:PublishProfile=win-x64
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\publish\win-x64\</PublishDir>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- true = ~120 МБ на диску, але користувачу нічого не треба ставити.
         false = ~2 МБ і вимога «встановіть .NET Desktop Runtime». -->
    <SelfContained>true</SelfContained>

    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>

    <!-- Trimming і NativeAOT з WPF не працюють — не вмикати. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
